{
  "name": "ds-ide",
  "displayName": "Daisy Seed IDE",
  "description": "Develop, test and debug Daisy Seed audio effects in VS Code, without hardware: an emulator with scope, controls, MIDI, OLED and SD card.",
  "version": "0.24.9",
  "publisher": "daisy-ide",
  "license": "PolyForm-Shield-1.0.0",
  "icon": "media/ds-ide-icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "preview": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bobpuley/ds-ide"
  },
  "homepage": "https://github.com/bobpuley/ds-ide#readme",
  "bugs": {
    "url": "https://github.com/bobpuley/ds-ide/issues"
  },
  "keywords": [
    "daisy seed",
    "electro-smith",
    "libdaisy",
    "daisysp",
    "audio",
    "dsp",
    "emulator",
    "midi",
    "embedded",
    "audio effects"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:*.cpp",
    "workspaceContains:src/*.cpp",
    "workspaceContains:source/*.cpp"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Daisy IDE builds and runs the project's code (CMake, the emulator, the debugger), so it needs a trusted folder."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ds-ide.build",
        "title": "Build for Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.deploy",
        "title": "Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.start",
        "title": "Start Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.stop",
        "title": "Stop Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.debug",
        "title": "Deploy and Debug",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildHardware",
        "title": "Build for Hardware",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.flash",
        "title": "Flash to Daisy Seed",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildAndDeploy",
        "title": "Build & Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.showScope",
        "title": "Show Scope",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.showOled",
        "title": "Show OLED Display",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.showMidi",
        "title": "Show MIDI Panel",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.focusControls",
        "title": "Focus Controls Editor",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.focusWiring",
        "title": "Focus Wiring Editor",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.createNewEffectProject",
        "title": "Create New Effect Project",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.selectActiveFolder",
        "title": "Select Active Workspace Folder",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.runEffect",
        "title": "Run Daisy Effect",
        "category": "Daisy IDE",
        "icon": "$(play)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.debugEffect",
        "title": "Debug Daisy Effect",
        "category": "Daisy IDE",
        "icon": "$(debug-alt)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.buildAndFlash",
        "title": "Build & Flash to Daisy Seed",
        "category": "Daisy IDE",
        "icon": "$(zap)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.stopEffect",
        "title": "Stop Daisy Effect",
        "category": "Daisy IDE",
        "icon": "$(debug-stop)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.cancelTransport",
        "title": "Cancel Build / Deploy",
        "category": "Daisy IDE",
        "icon": "$(close)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.restartEffect",
        "title": "Restart to Apply Changes",
        "category": "Daisy IDE",
        "icon": "$(debug-restart)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.refreshBoard",
        "title": "Refresh Board Detection",
        "category": "Daisy IDE",
        "icon": "$(refresh)",
        "enablement": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.showEmulatorOutput",
        "title": "Show Emulator Output",
        "category": "Daisy IDE",
        "icon": "$(output)"
      },
      {
        "command": "ds-ide.revealDaisyView",
        "title": "Show Daisy View",
        "category": "Daisy IDE",
        "icon": "$(circuit-board)"
      }
    ],
    "keybindings": [
      {
        "command": "ds-ide.build",
        "key": "ctrl+shift+alt+b",
        "mac": "cmd+shift+alt+b",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.deploy",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.start",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.stop",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "ds-ide.isDaisyProject"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "ds-ide.runEffect",
          "when": "ds-ide.isDaisyProject && ds-ide.isEffectSource",
          "group": "navigation@1"
        },
        {
          "command": "ds-ide.debugEffect",
          "when": "ds-ide.isDaisyProject && ds-ide.isEffectSource",
          "group": "navigation@2"
        },
        {
          "command": "ds-ide.buildAndFlash",
          "when": "ds-ide.isDaisyProject && ds-ide.isEffectSource",
          "group": "navigation@3"
        }
      ],
      "view/title": [
        {
          "command": "ds-ide.runEffect",
          "when": "view == ds-ide.daisyView && ds-ide.transportPhase =~ /^(stopped|buildFailed|crashed)$/",
          "group": "navigation@1"
        },
        {
          "command": "ds-ide.debugEffect",
          "when": "view == ds-ide.daisyView && ds-ide.transportPhase =~ /^(stopped|buildFailed|crashed)$/",
          "group": "navigation@2"
        },
        {
          "command": "ds-ide.stopEffect",
          "when": "view == ds-ide.daisyView && ds-ide.transportPhase =~ /^(running|debugging|paused)$/",
          "group": "navigation@1"
        },
        {
          "command": "ds-ide.cancelTransport",
          "when": "view == ds-ide.daisyView && ds-ide.transportPhase =~ /^(building|deploying)$/",
          "group": "navigation@1"
        },
        {
          "command": "ds-ide.buildAndFlash",
          "when": "view == ds-ide.daisyView",
          "group": "navigation@3"
        },
        {
          "command": "ds-ide.refreshBoard",
          "when": "view == ds-ide.daisyView",
          "group": "navigation@4"
        },
        {
          "command": "ds-ide.showEmulatorOutput",
          "when": "view == ds-ide.daisyView",
          "group": "navigation@5"
        },
        {
          "command": "ds-ide.buildHardware",
          "when": "view == ds-ide.daisyView",
          "group": "1_hardware@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ds-ide.restartEffect",
          "when": "view == ds-ide.daisyView && viewItem == daisy.stale",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ds-ide-controls",
          "title": "Controls Editor",
          "icon": "media/controls-editor-icon-dark.svg"
        },
        {
          "id": "ds-ide-wiring",
          "title": "Wiring Editor",
          "icon": "media/wiring-editor-icon-dark.svg"
        }
      ]
    },
    "views": {
      "ds-ide-controls": [
        {
          "type": "webview",
          "id": "ds-ide.controlsEditor",
          "name": "Controls Editor"
        }
      ],
      "ds-ide-wiring": [
        {
          "type": "webview",
          "id": "ds-ide.wiringEditor",
          "name": "Wiring Editor"
        }
      ],
      "debug": [
        {
          "id": "ds-ide.daisyView",
          "name": "Daisy"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "ds-ide.getStarted",
        "title": "Get started with Daisy Seed",
        "description": "Create an effect, wire a control, run it on the emulator and watch the output.",
        "steps": [
          {
            "id": "ds-ide.step.create",
            "title": "Create an effect project",
            "description": "Start from a working effect.\n[Create New Effect Project](command:ds-ide.createNewEffectProject)",
            "media": {
              "markdown": "media/walkthrough/create-project.md"
            }
          },
          {
            "id": "ds-ide.step.wire",
            "title": "Wire a pin",
            "description": "Drag a device onto the board.\n[Open the Wiring Editor](command:ds-ide.focusWiring)",
            "media": {
              "markdown": "media/walkthrough/wire-a-pin.md"
            }
          },
          {
            "id": "ds-ide.step.run",
            "title": "Run it on the emulator",
            "description": "No hardware needed.\n[Run Daisy Effect](command:ds-ide.runEffect)",
            "media": {
              "markdown": "media/walkthrough/run-effect.md"
            }
          },
          {
            "id": "ds-ide.step.scope",
            "title": "Watch and tune",
            "description": "See the waveforms and turn the knobs.\n[Show Scope](command:ds-ide.showScope)",
            "media": {
              "markdown": "media/walkthrough/watch-scope.md"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "ds-ide.daisyView",
        "contents": "Not a Daisy Seed project yet.\n[Create New Effect Project](command:ds-ide.createNewEffectProject)",
        "when": "!ds-ide.isDaisyProject"
      }
    ],
    "configuration": {
      "title": "Daisy IDE",
      "properties": {
        "ds-ide.effectSource": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the effect `.cpp` file, relative to project root or absolute. Leave empty for auto-detection.\n\nResolved with `window` scope (not per-folder): in a multi-root workspace, set this at the workspace level, not per-folder — a per-folder value is read without a resource context and will not take effect."
        },
        "ds-ide.armToolchainPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the ARM embedded toolchain binary or its `bin/` directory. Leave empty for auto-detection.\n\nMachine-specific — excluded from Settings Sync so a toolchain path from one machine can't silently apply on another; a workspace can still override it for that project."
        },
        "ds-ide.hardwareVariant": {
          "type": "string",
          "enum": [
            "base",
            "65mb-sdram"
          ],
          "default": "base",
          "scope": "resource",
          "markdownDescription": "Which physical Daisy Seed variant this project targets. The base board has no external SDRAM; only the \"65 MB\" variant does. Used to catch SDRAM usage that would fail on hardware even though the linker's memory-region report shows it fitting — the linker sizes the SDRAM region generically and can't know which board is actually connected.\n\nSet per project (resource-scoped) — the `Daisy IDE: New Effect Project` wizard prompts for this and pre-fills it for new projects."
        }
      }
    },
    "debuggers": [
      {
        "type": "daisy-debug",
        "label": "Daisy Debug (internal — attach-only, started by DS-IDE launch configurations)",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "pid"
            ],
            "properties": {
              "pid": {
                "type": "number",
                "description": "PID of the effect_emu process to attach to"
              }
            }
          }
        }
      },
      {
        "type": "ds-ide",
        "label": "DS-IDE",
        "languages": [
          "c",
          "cpp"
        ],
        "initialConfigurations": [
          {
            "type": "ds-ide",
            "request": "launch",
            "name": "DS-IDE: Build, Deploy & Debug"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {}
          }
        }
      }
    ]
  },
  "scripts": {
    "gen:pins": "tsx scripts/gen-pin-table.ts",
    "compile": "npm run gen:pins && node esbuild.js",
    "compile:watch": "npm run gen:pins && node esbuild.js --watch",
    "typecheck": "npm run gen:pins && tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "npm run gen:pins && vitest run",
    "test:watch": "npm run gen:pins && vitest",
    "test:e2e": "npm run compile && tsc -p tsconfig.e2e.json && vscode-test",
    "check:published-links": "node scripts/check-published-links.js",
    "lint": "npm run gen:pins && tsc --noEmit && tsc --noEmit -p tsconfig.webview.json && bash scripts/check-active-folder-convention.sh && node scripts/check-doc-commands.js",
    "package": "npm run gen:pins && node esbuild.js --production && npm run rebuild:native && vsce package --target darwin-arm64",
    "verify:package": "bash scripts/verify-vsix.sh",
    "rebuild:native": "bash scripts/rebuild-midi-native.sh",
    "postinstall": "npm run rebuild:native || true"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "midi": "2.0.0"
  }
}
