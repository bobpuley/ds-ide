{
  "name": "ds-ide",
  "displayName": "Daisy Seed IDE",
  "description": "Develop, test, and debug Daisy Seed audio effects without physical hardware.",
  "version": "0.0.1",
  "publisher": "daisy-ide",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/daisy-ide/ds-ide"
  },
  "homepage": "https://github.com/daisy-ide/ds-ide#readme",
  "keywords": [
    "daisy seed",
    "audio",
    "embedded",
    "emulator",
    "dsp"
  ],
  "activationEvents": [
    "onDebugResolve:ds-ide",
    "onDebugAdapterProtocolTracker:ds-ide"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ds-ide.build",
        "title": "Build for Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.deploy",
        "title": "Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.start",
        "title": "Start Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.stop",
        "title": "Stop Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.debug",
        "title": "Deploy and Debug",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.openControllerEditor",
        "title": "Open Controller Editor",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildHardware",
        "title": "Build for Hardware",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.flash",
        "title": "Flash to Daisy Seed",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.openWiringEditor",
        "title": "Open Wiring Editor",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildAndDeploy",
        "title": "Build & Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.createNewEffectProject",
        "title": "Create New Effect Project",
        "category": "Daisy IDE"
      }
    ],
    "keybindings": [
      {
        "command": "ds-ide.build",
        "key": "ctrl+shift+alt+b",
        "mac": "cmd+shift+alt+b"
      },
      {
        "command": "ds-ide.deploy",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d"
      },
      {
        "command": "ds-ide.start",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r"
      },
      {
        "command": "ds-ide.stop",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ds-ide-sidebar",
          "title": "DS-IDE",
          "icon": "media/ds-ide-icon.svg"
        }
      ]
    },
    "views": {
      "ds-ide-sidebar": [
        {
          "type": "webview",
          "id": "ds-ide.controlsEditor",
          "name": "Controls"
        },
        {
          "type": "webview",
          "id": "ds-ide.wiringEditor",
          "name": "Wiring"
        }
      ]
    },
    "configuration": {
      "title": "Daisy IDE",
      "properties": {
        "ds-ide.effectSource": {
          "type": "string",
          "default": "",
          "description": "Path to the effect .cpp file, relative to project root or absolute. Leave empty for auto-detection."
        },
        "ds-ide.armToolchainPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ARM embedded toolchain binary or its bin/ directory. Leave empty for auto-detection."
        }
      }
    },
    "debuggers": [
      {
        "type": "daisy-debug",
        "label": "Daisy Debug",
        "languages": ["c", "cpp"],
        "configurationAttributes": {
          "attach": {
            "required": ["pid"],
            "properties": {
              "pid": {
                "type": "number",
                "description": "PID of the effect_emu process to attach to"
              }
            }
          }
        }
      },
      {
        "type": "ds-ide",
        "label": "DS-IDE",
        "languages": ["c", "cpp"],
        "initialConfigurations": [
          {
            "type": "ds-ide",
            "request": "launch",
            "name": "DS-IDE: Build, Deploy & Debug"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {}
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "compile:watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "package": "node esbuild.js --production && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
