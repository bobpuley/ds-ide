{
  "name": "ds-ide",
  "displayName": "Daisy Seed IDE",
  "description": "Develop, test, and debug Daisy Seed audio effects without physical hardware.",
  "version": "0.14.1",
  "publisher": "daisy-ide",
  "license": "MIT",
  "icon": "media/ds-ide-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daisy-ide/ds-ide"
  },
  "homepage": "https://github.com/daisy-ide/ds-ide#readme",
  "keywords": [
    "daisy seed",
    "audio",
    "embedded",
    "emulator",
    "dsp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ds-ide.build",
        "title": "Build for Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.deploy",
        "title": "Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.start",
        "title": "Start Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.stop",
        "title": "Stop Audio",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.debug",
        "title": "Deploy and Debug",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildHardware",
        "title": "Build for Hardware",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.flash",
        "title": "Flash to Daisy Seed",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.buildAndDeploy",
        "title": "Build & Deploy to Emulator",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.createNewEffectProject",
        "title": "Create New Effect Project",
        "category": "Daisy IDE"
      },
      {
        "command": "ds-ide.selectActiveFolder",
        "title": "Select Active Workspace Folder",
        "category": "Daisy IDE"
      }
    ],
    "keybindings": [
      {
        "command": "ds-ide.build",
        "key": "ctrl+shift+alt+b",
        "mac": "cmd+shift+alt+b",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.deploy",
        "key": "ctrl+shift+alt+d",
        "mac": "cmd+shift+alt+d",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.start",
        "key": "ctrl+shift+alt+r",
        "mac": "cmd+shift+alt+r",
        "when": "ds-ide.isDaisyProject"
      },
      {
        "command": "ds-ide.stop",
        "key": "ctrl+shift+alt+s",
        "mac": "cmd+shift+alt+s",
        "when": "ds-ide.isDaisyProject"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ds-ide-controls",
          "title": "Controls Editor",
          "icon": "media/controls-editor-icon-dark.svg"
        },
        {
          "id": "ds-ide-wiring",
          "title": "Wiring Editor",
          "icon": "media/wiring-editor-icon-dark.svg"
        }
      ]
    },
    "views": {
      "ds-ide-controls": [
        {
          "type": "webview",
          "id": "ds-ide.controlsEditor",
          "name": "Controls Editor"
        }
      ],
      "ds-ide-wiring": [
        {
          "type": "webview",
          "id": "ds-ide.wiringEditor",
          "name": "Wiring Editor"
        }
      ]
    },
    "configuration": {
      "title": "Daisy IDE",
      "properties": {
        "ds-ide.effectSource": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the effect `.cpp` file, relative to project root or absolute. Leave empty for auto-detection.\n\nResolved with `window` scope (not per-folder): in a multi-root workspace, set this at the workspace level, not per-folder — a per-folder value is read without a resource context and will not take effect."
        },
        "ds-ide.armToolchainPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the ARM embedded toolchain binary or its `bin/` directory. Leave empty for auto-detection.\n\nMachine-specific — excluded from Settings Sync so a toolchain path from one machine can't silently apply on another; a workspace can still override it for that project."
        }
      }
    },
    "debuggers": [
      {
        "type": "daisy-debug",
        "label": "Daisy Debug (internal — attach-only, started by DS-IDE launch configurations)",
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "attach": {
            "required": [
              "pid"
            ],
            "properties": {
              "pid": {
                "type": "number",
                "description": "PID of the effect_emu process to attach to"
              }
            }
          }
        }
      },
      {
        "type": "ds-ide",
        "label": "DS-IDE",
        "languages": [
          "c",
          "cpp"
        ],
        "initialConfigurations": [
          {
            "type": "ds-ide",
            "request": "launch",
            "name": "DS-IDE: Build, Deploy & Debug"
          }
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {}
          }
        }
      }
    ]
  },
  "scripts": {
    "gen:pins": "tsx scripts/gen-pin-table.ts",
    "compile": "npm run gen:pins && node esbuild.js",
    "compile:watch": "npm run gen:pins && node esbuild.js --watch",
    "typecheck": "npm run gen:pins && tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "npm run gen:pins && vitest run",
    "test:watch": "npm run gen:pins && vitest",
    "lint": "npm run gen:pins && tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "package": "npm run gen:pins && node esbuild.js --production && vsce package --no-dependencies",
    "verify:package": "bash scripts/verify-vsix.sh"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  }
}
