{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "skipLibCheck": true
  },
  "include": [
    "src/webview/controls-webview.ts",
    "src/webview/scope-webview.ts",
    "src/webview/wiring-webview.ts",
    "src/webview/oled-webview.ts",
    "src/webview/oled-frame.ts",
    "src/webview/webview-api.d.ts",
    "src/webview/messages.ts",
    "src/webview/knob-math.ts",
    "src/wiring/id-validation.ts",
    "src/wiring/wired-pin-state.ts"
  ]
}
