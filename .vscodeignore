.vscode/**
.vscode-test/**
src/**
.gitignore
esbuild.js
vitest.config.ts
tsconfig.json
tsconfig.test.json
**/*.map
**/*.ts
# Only the bundles ship. (vsce applies `!` re-includes after all excludes, so a
# later `dist/**/*.map` exclude cannot undo a blanket `!dist/**`.)
!dist/**/*.js
node_modules/**
# midi (FR-DEV-18's host MIDI bridge) is a native addon esbuild can't inline
# into dist/extension.js — its runtime files (JS glue + prebuilt binary, plus
# its own bindings/file-uri-to-path dependency chain) are carved back in from
# the blanket node_modules/** exclusion above. Everything else under
# node_modules/midi/** (tests/, vendor/rtmidi source, build/Makefile, ...) is
# unnecessary bulk and stays excluded.
!node_modules/midi/package.json
!node_modules/midi/midi.js
!node_modules/midi/build/Release/midi.node
!node_modules/bindings/package.json
!node_modules/bindings/bindings.js
!node_modules/file-uri-to-path/package.json
!node_modules/file-uri-to-path/index.js
daisy-seed-knowledge/**
docs/**
graphify-out/**
# emulator/** sources are packaged — buildForEmulator needs them at runtime
# (FR-PKG-1); only build output directories are excluded.
emulator/**/build/**
# DaisySP (FR-PKG-3): only Source/ (what createEffectProject() copies into new
# projects) and LICENSE (MIT attribution) are packaged — the submodule's
# tests/docs/build-tooling/IDE-project files, and its DaisySP-LGPL/ nested
# submodule (a separately-licensed, never-initialized empty placeholder), are
# unnecessary bulk.
vendor/DaisySP/**
!vendor/DaisySP/Source/**
!vendor/DaisySP/LICENSE
tests/**
# vsce does not read .gitignore in this project's packaging setup — these
# gitignored, non-shipping directories must be listed explicitly or they end
# up bundled into the .vsix wholesale (found while verifying FR-PKG-1: a
# stray local .ds-ide/ build cache alone added ~89 MB to the package).
.ds-ide/**
examples/**/.ds-ide/**
examples/**/sdcard/**
examples/**/*.png
.ds-ide-shim-test/**
.idea/**
.claude/**
mockup/**
docs/raw/**
HANDOFF.md
*.tsbuildinfo

# Repo/dev files that no runtime code reads (verified by grep over src/).
out/**
scripts/**
.github/**
.gitmodules
.graphifyignore
.vscode-test.mjs
tsconfig.e2e.json
tsconfig.webview.json
CLAUDE.md
Seed_pinout.csv
devices-list.md
design_plan*.md
multiplatform_plan.md
# Stray screenshots dropped in the repo root; only media/ images (icon and the
# README screenshots) ship. vsce applies `!` re-includes after excludes.
*.png
!media/*.png
# graphify knowledge graphs are local, regenerable dev tooling (gitignored).
graphify-out-extension/**
**/graphify-out/**
.tsbuildinfo
dist/.tsbuildinfo
# Build-time input for `npm run gen:pins`; the generated table is compiled into dist/.
resources/**
